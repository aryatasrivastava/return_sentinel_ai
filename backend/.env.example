# ReturnSentinel AI - Database Configuration
#
# Supabase PostgreSQL Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use either the Direct Connection (port 5432) or Session Pooler (port 5432/6543)
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-supabase-ref.supabase.co:5432/postgres
